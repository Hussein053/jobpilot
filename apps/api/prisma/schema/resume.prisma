model Resume {
  id     String @id @default(uuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  label String
  approvedAt DateTime? @map("approved_at")
  approvedVersion Int? @map("approved_version")
  active Boolean @default(true)
  reviewRevision Int @default(0) @map("review_revision")

  sourceFilename  String? @map("source_filename")
  sourceMimeType  String? @map("source_mime_type")
  sourceSizeBytes Int?    @map("source_size_bytes")

  content Json?
  version Int   @default(1)

  variants     ResumeVariant[]
  primaryFor   User?           @relation("PrimaryResume")
  applications Application[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("resumes")
}

enum ResumeReviewAction {
  approve
  revoke
  activate
  deactivate
  @@map("resume_review_action")
}

model ResumeReviewEvent {
  id String @id @default(uuid())
  userId String @map("user_id")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Keep the review trail after a resume is removed; account deletion still cascades.
  resumeId String @map("resume_id")
  action ResumeReviewAction
  resumeVersion Int @map("resume_version")
  reviewRevision Int @map("review_revision")
  actorTokenId String @map("actor_token_id")
  createdAt DateTime @default(now()) @map("created_at")
  @@unique([resumeId, reviewRevision])
  @@index([userId, createdAt])
  @@map("resume_review_events")
}

model ResumeVariant {
  id       String @id @default(uuid())
  resumeId String @map("resume_id")
  resume   Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  label         String
  jobUrl        String?      @map("job_url")
  applicationId String?      @map("application_id")
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  // Applications submitted with this variant; distinct from `application` above, which is the one
  // application this variant was created for.
  usedByApplications Application[] @relation("ApplicationResumeUsed")

  content   Json
  diffNotes String? @map("diff_notes")

  // Audit of rewording and restructuring (`VariantRewriteAudit`); null when the variant only reranked.
  rewrites Json?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([resumeId])
  @@index([applicationId])
  @@map("resume_variants")
}
